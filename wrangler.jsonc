{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "salarysabi",
  "compatibility_date": "2026-07-29",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "salarysabi.com",
      "custom_domain": true
    },
    {
      "pattern": "www.salarysabi.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
