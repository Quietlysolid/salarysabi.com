{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "salarysabi",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "salarysabi.com",
      "custom_domain": true
    },
    {
      "pattern": "www.salarysabi.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "salarysabi"
    }
  ]
}
